// Modelo de dados: docs/03-modelo-de-dados.md. Tabelas e colunas em snake_case (@@map/@map),
// campos do domínio em português e identificadores UUID v7.
// Parte 2.1 (#6): acesso e configuração, cadastros base e auditoria.
// Parte 2.2 (#7): triagem, fila, senha, alocação, atendimento, ausência, desistência e alertas.
// Campos marcados "Sensível" são dado de saúde (Tabela 23): só saem em SenhaDetalhe (ADR-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // A API usa o usuário da aplicação; as migrações usam o administrador (dono das tabelas).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums (docs/03 §1) ──

enum VinculoPaciente {
  EXTERNO
  ALUNO
  SERVIDOR
}

enum Turno {
  MANHA
  TARDE
  NOITE
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

/// Tabela 4, ID04 do Documento de Requisitos.
enum SituacaoSala {
  DISPONIVEL
  EM_MANUTENCAO
  INDISPONIVEL
}

enum OperacaoAuditoria {
  CRIAR
  EDITAR
  EXCLUIR
  CONSULTAR_SENSIVEL
  EXPORTAR
  LOGIN
  LOGOUT
}

enum MotivoRevogacao {
  LOGOUT
  REUSO
  USUARIO_INATIVADO
  SENHA_REDEFINIDA
}

/// Os nove status da senha (Tabela 11, ID07); transições na Etapa 6 (docs/03 §5).
enum StatusSenha {
  AGUARDANDO
  CHAMADA
  AGUARDANDO_RECURSO
  EM_ATENDIMENTO
  PAUSADO
  PENDENTE_VALIDACAO
  ENCERRADO
  AUSENTE
  DESISTENCIA
}

/// O que faltou para alocar ("Manter aguardando" de W-11).
enum RecursoFaltante {
  ESTUDANTE
  SUPERVISOR
  SALA
}

enum Prioridade {
  NORMAL
  PREFERENCIAL
  URGENTE
}

enum TipoAtendimento {
  PRIMEIRA_CONSULTA
  RETORNO
  ENCAIXE
}

/// Valor único (Tabela 9, ID07); preenchido torna a prioridade PREFERENCIAL (RN-02).
enum EnquadramentoLegal {
  IDOSO
  GESTANTE
  LACTANTE
  PCD
  OUTRO_PREVISTO_EM_NORMA
}

enum Desfecho {
  ALTA
  RETORNO_AGENDADO
  ENCAMINHAMENTO_INTERNO
  ENCAMINHAMENTO_EXTERNO
}

enum TipoEncaminhamento {
  INTERNO
  EXTERNO
}

enum OrigemDesistencia {
  PACIENTE
  EQUIPE
}

enum TipoAlerta {
  SLA_EXCEDIDO
  FILA_BLOQUEADA
}

enum StatusAlerta {
  ATIVO
  RECONHECIDO
  NORMALIZADO
}

enum AcaoEscalonamento {
  REFORCO_ATENDENTE
  VAGA_EXTRA
}

/// Chaves de parametro_unidade (docs/03 §3.1, Tabela 8).
enum ChaveParametro {
  TOLERANCIA_MINUTOS           @map("tolerancia_minutos")
  SLA_MINUTOS                  @map("sla_minutos")
  REINCIDENCIAS_RESTRICAO      @map("reincidencias_restricao")
  JANELA_REINCIDENCIA_DIAS     @map("janela_reincidencia_dias")
  LIMITE_ESTUDANTES_SUPERVISOR @map("limite_estudantes_supervisor")
  JUSTIFICATIVA_MIN_CARACTERES @map("justificativa_min_caracteres")
}

// ── Acesso e configuração (docs/03 §3.1) ──

model Unidade {
  id    String  @id @default(uuid(7)) @db.Uuid
  nome  String
  ativo Boolean @default(true)

  parametros     ParametroUnidade[]
  usuarios       Usuario[]
  pacientes      Paciente[]
  salas          Sala[]
  especialidades Especialidade[]
  filas          Fila[]
  alertas        Alerta[]

  @@map("unidade")
}

/// Valor com especialidadeId sobrepõe o da unidade. Valores e restrições: parte 2.3 (#8).
model ParametroUnidade {
  id              String         @id @default(uuid(7)) @db.Uuid
  unidadeId       String         @map("unidade_id") @db.Uuid
  especialidadeId String?        @map("especialidade_id") @db.Uuid
  chave           ChaveParametro
  valor           Int
  atualizadoPor   String?        @map("atualizado_por") @db.Uuid
  atualizadoEm    DateTime       @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  unidade       Unidade        @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  especialidade Especialidade? @relation(fields: [especialidadeId], references: [id], onDelete: Restrict)
  autor         Usuario?       @relation(fields: [atualizadoPor], references: [id], onDelete: Restrict)

  /// Na migração este índice é recriado com NULLS NOT DISTINCT: um valor geral (sem especialidade) por chave.
  @@unique([unidadeId, especialidadeId, chave], map: "parametro_unidade_chave_key")
  @@map("parametro_unidade")
}

model Usuario {
  id               String    @id @default(uuid(7)) @db.Uuid
  nome             String
  /// Matrícula ou e-mail institucional; gravada em minúsculas e sem espaços nas pontas.
  identificacao    String    @unique
  senhaHash        String    @map("senha_hash")
  perfilId         String    @map("perfil_id") @db.Uuid
  unidadeId        String    @map("unidade_id") @db.Uuid
  ativo            Boolean   @default(true)
  tentativasFalhas Int       @default(0) @map("tentativas_falhas")
  bloqueadoAte     DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  ultimoLoginEm    DateTime? @map("ultimo_login_em") @db.Timestamptz(3)

  perfil                Perfil                      @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  unidade               Unidade                     @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  registrosAuditoria    AuditLog[]
  parametrosAtualizados ParametroUnidade[]
  sessoes               Sessao[]
  triagens              Triagem[]
  reclassificacoes      ReclassificacaoPrioridade[]
  chamadas              Chamada[]
  alocacoesConfirmadas  Alocacao[]
  atendimentosValidados Atendimento[]
  pausas                PausaAtendimento[]
  encaminhamentos       Encaminhamento[]
  ausencias             Ausencia[]
  desistencias          Desistencia[]
  alertasReconhecidos   Alerta[]
  escalonamentos        Escalonamento[]
  chavesIdempotencia    ChaveIdempotencia[]

  @@map("usuario")
}

/// Uma por login: renova e revoga o refresh token (docs/04 §2). O segredo do refresh nunca é
/// gravado, só o SHA-256 dele; `hash_anterior` é aceito por 30 s depois da rotação.
model Sessao {
  id              String           @id @default(uuid(7)) @db.Uuid
  usuarioId       String           @map("usuario_id") @db.Uuid
  tokenHash       String           @map("token_hash")
  hashAnterior    String?          @map("hash_anterior")
  rotacionadaEm   DateTime?        @map("rotacionada_em") @db.Timestamptz(3)
  /// Login + 8 h; a renovação não estende.
  expiraEm        DateTime         @map("expira_em") @db.Timestamptz(3)
  /// Define se o cookie de refresh é persistente (docs/04 §2).
  manterConectado Boolean          @default(false) @map("manter_conectado")
  revogadaEm      DateTime?        @map("revogada_em") @db.Timestamptz(3)
  motivoRevogacao MotivoRevogacao? @map("motivo_revogacao")
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("sessao")
}

/// Perfil com `sistema` não é editável nem excluível (T-05); exclusão com usuário vinculado é bloqueada pela FK.
model Perfil {
  id        String  @id @default(uuid(7)) @db.Uuid
  nome      String  @unique
  descricao String?
  sistema   Boolean @default(false)

  permissoes PerfilPermissao[]
  usuarios   Usuario[]

  @@map("perfil")
}

/// `permissao` no formato `modulo:operacao`; o catálogo é constante no código (docs/04 §3).
model PerfilPermissao {
  perfilId  String @map("perfil_id") @db.Uuid
  permissao String

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissao])
  @@map("perfil_permissao")
}

/// Append-only (RNF-05): o REVOKE de UPDATE/DELETE fica na parte 2.3 (#8).
/// Usuário nunca é excluído (FK Restrict): a trilha é retida por no mínimo 5 anos (docs/03 §6).
model AuditLog {
  id                  String            @id @default(uuid(7)) @db.Uuid
  /// Nulo em operação feita por rotina agendada, sem usuário.
  usuarioId           String?           @map("usuario_id") @db.Uuid
  perfilNomeNoMomento String?           @map("perfil_nome_no_momento")
  operacao            OperacaoAuditoria
  modulo              String
  entidade            String
  entidadeId          String?           @map("entidade_id") @db.Uuid
  justificativa       String?
  origemIp            String?           @map("origem_ip")
  userAgent           String?           @map("user_agent")
  /// X-Request-Id da requisição (docs/04 §9), para ligar o registro ao log.
  requestId           String?           @map("request_id")
  sensivel            Boolean           @default(false)
  ocorridoEm          DateTime          @default(now()) @map("ocorrido_em") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([ocorridoEm])
  @@index([usuarioId, ocorridoEm])
  @@index([entidade, entidadeId])
  @@map("audit_log")
}

// ── Cadastros base (docs/03 §3.2, RF-01) ──

/// Duplicidade por `documento` (único) e por `nome_completo` + `data_nascimento` (verificada no service).
model Paciente {
  id              String          @id @default(uuid(7)) @db.Uuid
  nomeCompleto    String          @map("nome_completo")
  /// Só dígitos, normalizado antes de gravar.
  documento       String          @unique
  dataNascimento  DateTime        @map("data_nascimento") @db.Date
  contatoTelefone String?         @map("contato_telefone")
  contatoEmail    String?         @map("contato_email")
  vinculo         VinculoPaciente
  unidadeId       String          @map("unidade_id") @db.Uuid
  restricaoAtiva  Boolean         @default(false) @map("restricao_ativa")
  restricaoAte    DateTime?       @map("restricao_ate") @db.Date
  ativo           Boolean         @default(true)

  unidade  Unidade   @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  triagens Triagem[]
  senhas   Senha[]

  @@index([nomeCompleto, dataNascimento])
  @@map("paciente")
}

model Estudante {
  id              String  @id @default(uuid(7)) @db.Uuid
  nome            String
  especialidadeId String  @map("especialidade_id") @db.Uuid
  nivelFormacao   String  @map("nivel_formacao")
  ativo           Boolean @default(true)

  especialidade    Especialidade              @relation(fields: [especialidadeId], references: [id], onDelete: Restrict)
  habilitacoes     EstudanteHabilitacao[]
  procedimentos    EstudanteProcedimento[]
  disponibilidades EstudanteDisponibilidade[]
  alocacoes        Alocacao[]

  @@map("estudante")
}

model EstudanteHabilitacao {
  estudanteId   String @map("estudante_id") @db.Uuid
  habilitacaoId String @map("habilitacao_id") @db.Uuid

  estudante   Estudante   @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  habilitacao Habilitacao @relation(fields: [habilitacaoId], references: [id], onDelete: Restrict)

  @@id([estudanteId, habilitacaoId])
  @@map("estudante_habilitacao")
}

model EstudanteProcedimento {
  estudanteId    String @map("estudante_id") @db.Uuid
  procedimentoId String @map("procedimento_id") @db.Uuid

  estudante    Estudante    @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  procedimento Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Restrict)

  @@id([estudanteId, procedimentoId])
  @@map("estudante_procedimento")
}

model EstudanteDisponibilidade {
  estudanteId String    @map("estudante_id") @db.Uuid
  diaSemana   DiaSemana @map("dia_semana")
  turno       Turno

  estudante Estudante @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([estudanteId, diaSemana, turno])
  @@map("estudante_disponibilidade")
}

/// Sem `limite_estudantes_simultaneos`, vale o parâmetro `limite_estudantes_supervisor` da unidade (Tabela 8, ID05).
model Supervisor {
  id                          String  @id @default(uuid(7)) @db.Uuid
  nome                        String
  limiteEstudantesSimultaneos Int?    @map("limite_estudantes_simultaneos")
  ativo                       Boolean @default(true)

  especialidades   SupervisorEspecialidade[]
  procedimentos    SupervisorProcedimento[]
  disponibilidades SupervisorDisponibilidade[]
  alocacoes        Alocacao[]

  @@map("supervisor")
}

model SupervisorEspecialidade {
  supervisorId    String @map("supervisor_id") @db.Uuid
  especialidadeId String @map("especialidade_id") @db.Uuid

  supervisor    Supervisor    @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  especialidade Especialidade @relation(fields: [especialidadeId], references: [id], onDelete: Restrict)

  @@id([supervisorId, especialidadeId])
  @@map("supervisor_especialidade")
}

model SupervisorProcedimento {
  supervisorId   String @map("supervisor_id") @db.Uuid
  procedimentoId String @map("procedimento_id") @db.Uuid

  supervisor   Supervisor   @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  procedimento Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Restrict)

  @@id([supervisorId, procedimentoId])
  @@map("supervisor_procedimento")
}

model SupervisorDisponibilidade {
  supervisorId String    @map("supervisor_id") @db.Uuid
  diaSemana    DiaSemana @map("dia_semana")
  turno        Turno

  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@id([supervisorId, diaSemana, turno])
  @@map("supervisor_disponibilidade")
}

model Sala {
  id              String       @id @default(uuid(7)) @db.Uuid
  identificacao   String
  unidadeId       String       @map("unidade_id") @db.Uuid
  caracteristicas String?
  situacao        SituacaoSala @default(DISPONIVEL)
  ativo           Boolean      @default(true)

  unidade   Unidade       @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  recursos  SalaRecurso[]
  alocacoes Alocacao[]

  @@map("sala")
}

model SalaRecurso {
  salaId    String @map("sala_id") @db.Uuid
  recursoId String @map("recurso_id") @db.Uuid

  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)
  recurso Recurso @relation(fields: [recursoId], references: [id], onDelete: Restrict)

  @@id([salaId, recursoId])
  @@map("sala_recurso")
}

model Especialidade {
  id                         String  @id @default(uuid(7)) @db.Uuid
  nome                       String  @unique
  descricao                  String?
  exigeSupervisaoDocente     Boolean @default(false) @map("exige_supervisao_docente")
  exigeValidacaoEncerramento Boolean @default(false) @map("exige_validacao_encerramento")
  unidadeId                  String  @map("unidade_id") @db.Uuid
  ativo                      Boolean @default(true)

  unidade          Unidade                              @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  recursosExigidos EspecialidadeProcedimentoRequisito[]
  estudantes       Estudante[]
  supervisores     SupervisorEspecialidade[]
  parametros       ParametroUnidade[]
  filas            Fila[]
  triagens         Triagem[]
  encaminhamentos  Encaminhamento[]

  @@map("especialidade")
}

/// Recursos que a sala precisa ter para atender a especialidade (RN-09). Nome conforme docs/03 §3.2.
model EspecialidadeProcedimentoRequisito {
  especialidadeId String @map("especialidade_id") @db.Uuid
  recursoId       String @map("recurso_id") @db.Uuid

  especialidade Especialidade @relation(fields: [especialidadeId], references: [id], onDelete: Cascade)
  recurso       Recurso       @relation(fields: [recursoId], references: [id], onDelete: Restrict)

  @@id([especialidadeId, recursoId])
  @@map("especialidade_procedimento_requisito")
}

// ── Tabelas de apoio: RN-06 e RN-09 comparam conjuntos, por isso não são texto livre ──

model Habilitacao {
  id   String @id @default(uuid(7)) @db.Uuid
  nome String @unique

  estudantes EstudanteHabilitacao[]

  @@map("habilitacao")
}

model Procedimento {
  id   String @id @default(uuid(7)) @db.Uuid
  nome String @unique

  estudantes   EstudanteProcedimento[]
  supervisores SupervisorProcedimento[]

  @@map("procedimento")
}

model Recurso {
  id   String @id @default(uuid(7)) @db.Uuid
  nome String @unique

  salas          SalaRecurso[]
  especialidades EspecialidadeProcedimentoRequisito[]

  @@map("recurso")
}

// ── Fila e senha (docs/03 §3.3) ──

/// Uma fila ativa por especialidade e unidade: índice único parcial na parte 2.3 (#8).
model Fila {
  id              String    @id @default(uuid(7)) @db.Uuid
  especialidadeId String    @map("especialidade_id") @db.Uuid
  unidadeId       String    @map("unidade_id") @db.Uuid
  nome            String
  /// Letra do número da senha (F014); o número é gerado no service (Etapa 5).
  letraSenha      String    @map("letra_senha") @db.Char(1)
  ativa           Boolean   @default(true)
  /// RN-10: falta de supervisor disponível na especialidade.
  bloqueada       Boolean   @default(false)
  bloqueadaMotivo String?   @map("bloqueada_motivo")
  bloqueadaDesde  DateTime? @map("bloqueada_desde") @db.Timestamptz(3)
  /// Sobrepõe o parâmetro sla_minutos da unidade.
  slaMinutos      Int?      @map("sla_minutos")

  especialidade Especialidade   @relation(fields: [especialidadeId], references: [id], onDelete: Restrict)
  unidade       Unidade         @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  senhas        Senha[]
  alertas       Alerta[]
  contadores    ContadorSenha[]

  @@index([especialidadeId])
  @@map("fila")
}

/// Sequência do número da senha por fila e dia no fuso da unidade: o UPDATE ... RETURNING da
/// emissão serializa emissões simultâneas. O índice único (fila, número, dia) da senha fica na
/// migração, por ser de expressão.
model ContadorSenha {
  filaId String   @map("fila_id") @db.Uuid
  dia    DateTime @db.Date
  ultimo Int

  fila Fila @relation(fields: [filaId], references: [id], onDelete: Restrict)

  @@id([filaId, dia])
  @@map("contador_senha")
}

model Triagem {
  id                     String              @id @default(uuid(7)) @db.Uuid
  pacienteId             String              @map("paciente_id") @db.Uuid
  profissionalId         String              @map("profissional_id") @db.Uuid
  especialidadeDestinoId String              @map("especialidade_destino_id") @db.Uuid
  tipoAtendimento        TipoAtendimento     @map("tipo_atendimento")
  prioridade             Prioridade
  /// Sensível.
  motivo                 String
  enquadramentoLegal     EnquadramentoLegal? @map("enquadramento_legal")
  /// Sensível. Obrigatória com prioridade URGENTE (RN-03).
  justificativaClinica   String?             @map("justificativa_clinica")
  /// Sensível.
  observacoes            String?
  concluidaEm            DateTime            @default(now()) @map("concluida_em") @db.Timestamptz(3)
  criadoEm               DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)

  paciente             Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profissional         Usuario       @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  especialidadeDestino Especialidade @relation(fields: [especialidadeDestinoId], references: [id], onDelete: Restrict)
  senhas               Senha[]

  @@index([pacienteId])
  @@map("triagem")
}

/// Agregado central: a passagem do paciente pela fila (Tabela 11).
model Senha {
  id                        String           @id @default(uuid(7)) @db.Uuid
  /// Letra da fila + sequência do dia com 3 dígitos (F014), único por fila e dia (migração).
  numero                    String
  filaId                    String           @map("fila_id") @db.Uuid
  triagemId                 String           @map("triagem_id") @db.Uuid
  pacienteId                String           @map("paciente_id") @db.Uuid
  prioridade                Prioridade
  tipoAtendimento           TipoAtendimento  @map("tipo_atendimento")
  status                    StatusSenha      @default(AGUARDANDO)
  /// Terceiro critério de ordenação (RN-04).
  temAgendamentoPrevio      Boolean          @default(false) @map("tem_agendamento_previo")
  chegadaEm                 DateTime         @default(now()) @map("chegada_em") @db.Timestamptz(3)
  chamadaEm                 DateTime?        @map("chamada_em") @db.Timestamptz(3)
  toleranciaAte             DateTime?        @map("tolerancia_ate") @db.Timestamptz(3)
  iniciadaEm                DateTime?        @map("iniciada_em") @db.Timestamptz(3)
  encerradaEm               DateTime?        @map("encerrada_em") @db.Timestamptz(3)
  /// Vezes que voltou à fila por tolerância expirada; na segunda expiração vira ausência (RN-12).
  retornosTolerancia        Int              @default(0) @map("retornos_tolerancia")
  /// Registrado em AGUARDANDO_RECURSO; a máquina de estados zera ao sair dele.
  recursoFaltante           RecursoFaltante? @map("recurso_faltante")
  recursoFaltanteObservacao String?          @map("recurso_faltante_observacao")
  /// Senha que originou esta por encaminhamento interno (RF-08).
  senhaOrigemId             String?          @map("senha_origem_id") @db.Uuid
  /// Bloqueio otimista: 409 VERSAO_DESATUALIZADA (docs/04 §6).
  versao                    Int              @default(1)
  criadoEm                  DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  fila             Fila                        @relation(fields: [filaId], references: [id], onDelete: Restrict)
  triagem          Triagem                     @relation(fields: [triagemId], references: [id], onDelete: Restrict)
  paciente         Paciente                    @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  senhaOrigem      Senha?                      @relation("SenhaOrigem", fields: [senhaOrigemId], references: [id], onDelete: Restrict)
  senhasDerivadas  Senha[]                     @relation("SenhaOrigem")
  reclassificacoes ReclassificacaoPrioridade[]
  chamadas         Chamada[]
  alocacoes        Alocacao[]
  atendimento      Atendimento?
  encaminhamentoDe Encaminhamento?             @relation("EncaminhamentoSenhaGerada")
  ausencias        Ausencia[]
  desistencia      Desistencia?

  /// Índice de ordenação da RN-04: o enum Prioridade está em ordem crescente de precedência.
  @@index([filaId, status, prioridade(sort: Desc), chegadaEm, temAgendamentoPrevio(sort: Desc)], map: "idx_senha_ordem")
  @@index([pacienteId])
  @@map("senha")
}

model ReclassificacaoPrioridade {
  id             String     @id @default(uuid(7)) @db.Uuid
  senhaId        String     @map("senha_id") @db.Uuid
  dePrioridade   Prioridade @map("de_prioridade")
  paraPrioridade Prioridade @map("para_prioridade")
  /// Obrigatória (RN-01); tamanho mínimo pelo parâmetro justificativa_min_caracteres.
  justificativa  String
  usuarioId      String     @map("usuario_id") @db.Uuid
  ocorridoEm     DateTime   @default(now()) @map("ocorrido_em") @db.Timestamptz(3)

  senha   Senha   @relation(fields: [senhaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([senhaId])
  @@map("reclassificacao_prioridade")
}

model Chamada {
  id            String   @id @default(uuid(7)) @db.Uuid
  senhaId       String   @map("senha_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  /// Local exibido no telão (W-09).
  localExibicao String   @map("local_exibicao")
  /// 1 = primeira chamada, 2+ = rechamadas.
  sequencia     Int      @default(1)
  chamadoEm     DateTime @default(now()) @map("chamado_em") @db.Timestamptz(3)

  senha   Senha   @relation(fields: [senhaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([senhaId, sequencia])
  @@index([chamadoEm])
  @@map("chamada")
}

// ── Alocação e atendimento (docs/03 §3.4) ──

/// Estudante, supervisor e sala sem duas alocações não liberadas: índices parciais na parte 2.3 (RN-05, RN-09).
model Alocacao {
  id            String    @id @default(uuid(7)) @db.Uuid
  senhaId       String    @map("senha_id") @db.Uuid
  estudanteId   String    @map("estudante_id") @db.Uuid
  /// Nulo só quando a especialidade não exige supervisão docente (RN-07).
  supervisorId  String?   @map("supervisor_id") @db.Uuid
  salaId        String    @map("sala_id") @db.Uuid
  confirmadaPor String    @map("confirmada_por") @db.Uuid
  confirmadaEm  DateTime  @default(now()) @map("confirmada_em") @db.Timestamptz(3)
  liberadaEm    DateTime? @map("liberada_em") @db.Timestamptz(3)

  senha        Senha         @relation(fields: [senhaId], references: [id], onDelete: Restrict)
  estudante    Estudante     @relation(fields: [estudanteId], references: [id], onDelete: Restrict)
  supervisor   Supervisor?   @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  sala         Sala          @relation(fields: [salaId], references: [id], onDelete: Restrict)
  autor        Usuario       @relation(fields: [confirmadaPor], references: [id], onDelete: Restrict)
  atendimentos Atendimento[]

  @@index([senhaId])
  @@map("alocacao")
}

model Atendimento {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Um atendimento por senha (RF-07).
  senhaId           String    @unique @map("senha_id") @db.Uuid
  alocacaoId        String    @map("alocacao_id") @db.Uuid
  iniciadoEm        DateTime  @default(now()) @map("iniciado_em") @db.Timestamptz(3)
  encerradoEm       DateTime? @map("encerrado_em") @db.Timestamptz(3)
  desfecho          Desfecho?
  /// Sensível.
  observacoes       String?
  /// Copiado da especialidade no início: mudar o cadastro não altera atendimento em curso (RN-11).
  validacaoExigida  Boolean   @map("validacao_exigida")
  validadoPor       String?   @map("validado_por") @db.Uuid
  validadoEm        DateTime? @map("validado_em") @db.Timestamptz(3)
  /// Sensível.
  parecerSupervisor String?   @map("parecer_supervisor")
  versao            Int       @default(1)

  senha           Senha              @relation(fields: [senhaId], references: [id], onDelete: Restrict)
  alocacao        Alocacao           @relation(fields: [alocacaoId], references: [id], onDelete: Restrict)
  validador       Usuario?           @relation(fields: [validadoPor], references: [id], onDelete: Restrict)
  pausas          PausaAtendimento[]
  encaminhamentos Encaminhamento[]

  @@map("atendimento")
}

/// Uma linha por pausa; o tempo efetivo desconta a soma das pausas (RF-10).
model PausaAtendimento {
  id            String    @id @default(uuid(7)) @db.Uuid
  atendimentoId String    @map("atendimento_id") @db.Uuid
  motivo        String?
  pausadoPor    String    @map("pausado_por") @db.Uuid
  pausadoEm     DateTime  @default(now()) @map("pausado_em") @db.Timestamptz(3)
  retomadoEm    DateTime? @map("retomado_em") @db.Timestamptz(3)

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  autor       Usuario     @relation(fields: [pausadoPor], references: [id], onDelete: Restrict)

  @@index([atendimentoId])
  @@map("pausa_atendimento")
}

model Encaminhamento {
  id                     String             @id @default(uuid(7)) @db.Uuid
  atendimentoId          String             @map("atendimento_id") @db.Uuid
  tipo                   TipoEncaminhamento
  /// Encaminhamento interno.
  especialidadeDestinoId String?            @map("especialidade_destino_id") @db.Uuid
  /// Encaminhamento externo.
  instituicaoDestino     String?            @map("instituicao_destino")
  motivo                 String
  prioridadeSugerida     Prioridade?        @map("prioridade_sugerida")
  /// O interno gera nova entrada de fila (RF-08).
  senhaGeradaId          String?            @unique @map("senha_gerada_id") @db.Uuid
  observacoes            String?
  criadoPor              String             @map("criado_por") @db.Uuid
  criadoEm               DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)

  atendimento          Atendimento    @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  especialidadeDestino Especialidade? @relation(fields: [especialidadeDestinoId], references: [id], onDelete: Restrict)
  senhaGerada          Senha?         @relation("EncaminhamentoSenhaGerada", fields: [senhaGeradaId], references: [id], onDelete: Restrict)
  autor                Usuario        @relation(fields: [criadoPor], references: [id], onDelete: Restrict)

  @@index([atendimentoId])
  @@map("encaminhamento")
}

// ── Ausência, desistência e alertas (docs/03 §3.5) ──

model Ausencia {
  id            String   @id @default(uuid(7)) @db.Uuid
  senhaId       String   @map("senha_id") @db.Uuid
  /// Expiração da tolerância (RN-12); manual quando falso.
  automatica    Boolean
  observacao    String?
  /// Nulo quando registrada pela rotina agendada.
  registradoPor String?  @map("registrado_por") @db.Uuid
  registradoEm  DateTime @default(now()) @map("registrado_em") @db.Timestamptz(3)

  senha Senha    @relation(fields: [senhaId], references: [id], onDelete: Restrict)
  autor Usuario? @relation(fields: [registradoPor], references: [id], onDelete: Restrict)

  @@index([senhaId])
  @@index([registradoEm])
  @@map("ausencia")
}

/// Separada de ausencia: alimentam indicadores distintos (W-16, RF-10).
model Desistencia {
  id            String            @id @default(uuid(7)) @db.Uuid
  senhaId       String            @unique @map("senha_id") @db.Uuid
  origem        OrigemDesistencia
  motivo        String?
  registradoPor String            @map("registrado_por") @db.Uuid
  registradoEm  DateTime          @default(now()) @map("registrado_em") @db.Timestamptz(3)

  senha Senha   @relation(fields: [senhaId], references: [id], onDelete: Restrict)
  autor Usuario @relation(fields: [registradoPor], references: [id], onDelete: Restrict)

  @@index([registradoEm])
  @@map("desistencia")
}

model Alerta {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tipo               TipoAlerta
  filaId             String       @map("fila_id") @db.Uuid
  unidadeId          String       @map("unidade_id") @db.Uuid
  status             StatusAlerta @default(ATIVO)
  tempoEsperaMinutos Int?         @map("tempo_espera_minutos")
  limiteMinutos      Int?         @map("limite_minutos")
  senhasAfetadas     Int?         @map("senhas_afetadas")
  disparadoEm        DateTime     @default(now()) @map("disparado_em") @db.Timestamptz(3)
  reconhecidoPor     String?      @map("reconhecido_por") @db.Uuid
  reconhecidoEm      DateTime?    @map("reconhecido_em") @db.Timestamptz(3)
  normalizadoEm      DateTime?    @map("normalizado_em") @db.Timestamptz(3)

  fila           Fila            @relation(fields: [filaId], references: [id], onDelete: Restrict)
  unidade        Unidade         @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  reconhecedor   Usuario?        @relation(fields: [reconhecidoPor], references: [id], onDelete: Restrict)
  escalonamentos Escalonamento[]

  @@index([filaId, status])
  @@map("alerta")
}

/// Autor e horário de cada ação de escalonamento (T-17).
model Escalonamento {
  id          String            @id @default(uuid(7)) @db.Uuid
  alertaId    String            @map("alerta_id") @db.Uuid
  acao        AcaoEscalonamento
  observacao  String?
  acionadoPor String            @map("acionado_por") @db.Uuid
  acionadoEm  DateTime          @default(now()) @map("acionado_em") @db.Timestamptz(3)

  alerta Alerta  @relation(fields: [alertaId], references: [id], onDelete: Restrict)
  autor  Usuario @relation(fields: [acionadoPor], references: [id], onDelete: Restrict)

  @@index([alertaId])
  @@map("escalonamento")
}

// ── Idempotência (docs/04 §6) ──

/// Resposta guardada por 10 minutos para `Idempotency-Key` repetida na chamada e na alocação.
model ChaveIdempotencia {
  usuarioId  String   @map("usuario_id") @db.Uuid
  chave      String   @db.Uuid
  /// Método e rota, para a mesma chave não valer em outra operação.
  operacao   String
  statusHttp Int      @map("status_http")
  resposta   Json
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([usuarioId, chave])
  @@index([criadoEm])
  @@map("chave_idempotencia")
}
