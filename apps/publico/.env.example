# Copie para apps/publico/.env.local. A simulação é padrão apenas em desenvolvimento.
NEXT_PUBLIC_API_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3333
NEXT_PUBLIC_UNIDADE_ID=unidade-demonstracao
NEXT_PUBLIC_UNIDADE_NOME=Clínica-Escola

# Para usar #19/#20: API_MOCK=false e UUID real da unidade.
# Entrada na sala do /painel via query unidadeId: proposta de adaptação, confirmar com #19.

# #51: som do telão; volume entre 0 e 1; arquivo servido pela própria aplicação.
NEXT_PUBLIC_TELAO_SOM_ATIVO=true
NEXT_PUBLIC_TELAO_SOM_VOLUME=0.5
NEXT_PUBLIC_TELAO_SOM_ARQUIVO=/sons/chamada.wav
