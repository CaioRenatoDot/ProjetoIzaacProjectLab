# Copie para .env e ajuste se necessário. O .env não é versionado.
# Nenhum dado real de paciente em ambiente local (RNF-07).

# --- Docker Compose ---
POSTGRES_USER=filas
POSTGRES_PASSWORD=filas
POSTGRES_DB=filas_dev
# Troque se a porta 5432 já estiver em uso na sua máquina.
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Usuário de banco da aplicação: não é dono das tabelas e não altera nem apaga o audit_log
# (RNF-05). Criado na primeira subida do volume; mudou a senha? `docker compose down -v`.
FILAS_APP_PASSWORD=filas_app

# --- API (Prisma) ---
# DATABASE_URL: a API conecta com o usuário da aplicação.
# DIRECT_URL: as migrações rodam com o usuário administrador (dono das tabelas).
DATABASE_URL=postgresql://filas_app:filas_app@localhost:5432/filas_dev?schema=public
DIRECT_URL=postgresql://filas:filas@localhost:5432/filas_dev?schema=public
DATABASE_URL_TEST=postgresql://filas_app:filas_app@localhost:5432/filas_test?schema=public
DIRECT_URL_TEST=postgresql://filas:filas@localhost:5432/filas_test?schema=public
# Origens liberadas no CORS (web e publico), separadas por vírgula.
CORS_ORIGENS=http://localhost:3000,http://localhost:3001
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# --- Aplicações de tela ---
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
